<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ metaTitle if metaTitle else t.meta.title }}</title>
<meta name="description" content="{{ metaDescription if metaDescription else t.meta.description }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- else %}
<link rel="canonical" href="{{ canonical }}">
<link rel="alternate" hreflang="es" href="https://felipe-gonzalez.com/">
<link rel="alternate" hreflang="en" href="https://felipe-gonzalez.com/en/">
<link rel="alternate" hreflang="x-default" href="https://felipe-gonzalez.com/">
<meta property="og:title" content="{{ t.meta.title }}">
<meta property="og:description" content="{{ metaDescription if metaDescription else t.meta.description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:type" content="profile">
<meta property="og:locale" content="{{ ogLocale }}">
<meta property="og:image" content="https://felipe-gonzalez.com/img/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ t.meta.title }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:creator" content="@felipezul">
<script type="application/ld+json">{{ personJsonLd | dump | safe }}</script>
{%- endif %}
<meta name="theme-color" content="#000000">
<link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css">
<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.17.2/dist/cdn.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.17.2/dist/cdn.min.js"></script>
<script defer src="/js/dust.js"></script>
</head>

<body class="bg-void text-ivory">

<canvas id="dust" class="dust-canvas" aria-hidden="true"></canvas>

{{ content | safe }}

</body>
</html>

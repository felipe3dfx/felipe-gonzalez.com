---
layout: base.njk
---
{%- set roles = t.work.roles | reverse -%}
{%- set n = t.work.roles | length -%}
{%- set last = n - 1 -%}
{%- set tones = ["var(--color-ivory)", "var(--color-mist)", "var(--color-haze)", "var(--color-frost)"] -%}
{%- set tracks = ["0", "0.02em", "0.04em", "0.06em"] -%}

<div x-data="{ active: '', open: false, pastHero: false }">

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-void focus:px-3 focus:py-2 focus:text-ivory">{{ t.skip }}</a>

<header class="void-fade sticky top-0 z-30 bg-void" @click.outside="open = false" @keydown.escape.window="open = false">
  <div class="mx-auto max-w-[1600px] px-6 md:px-10 lg:px-16">
    <div class="flex h-14 items-center gap-x-5 md:h-16 md:gap-x-8">

      <div class="flex shrink-0 items-center gap-3">
        <svg viewBox="0 0 14 9" width="28" height="18" shape-rendering="crispEdges" aria-hidden="true" class="shrink-0">
          <g fill="currentColor">
            <rect x="1" y="1" width="4" height="1"></rect>
            <rect x="1" y="2" width="1" height="1"></rect>
            <rect x="1" y="3" width="1" height="1"></rect>
            <rect x="1" y="4" width="3" height="1"></rect>
            <rect x="1" y="5" width="1" height="1"></rect>
            <rect x="1" y="6" width="1" height="1"></rect>
            <rect x="1" y="7" width="1" height="1"></rect>
            <rect x="7" y="1" width="4" height="1"></rect>
            <rect x="6" y="2" width="1" height="1"></rect>
            <rect x="6" y="3" width="1" height="1"></rect>
            <rect x="6" y="4" width="1" height="1"></rect>
            <rect x="8" y="4" width="3" height="1"></rect>
            <rect x="6" y="5" width="1" height="1"></rect>
            <rect x="10" y="5" width="1" height="1"></rect>
            <rect x="6" y="6" width="1" height="1"></rect>
            <rect x="10" y="6" width="1" height="1"></rect>
            <rect x="7" y="7" width="3" height="1"></rect>
          </g>
          <rect x="12" y="7" width="1" height="1" fill="#FFB000"></rect>
        </svg>
        <span class="invisible hidden text-label text-ivory sm:inline" :class="{ invisible: !pastHero }">{{ t.site }}</span>
      </div>

      <nav class="ml-auto hidden shrink-0 xl:block" aria-label="{{ t.navLabel }}">
        <ul class="flex flex-nowrap items-center gap-x-7 text-label text-haze">
          {%- for item in t.nav %}
          {%- set id = item.href | replace("#", "") %}
          <li><a href="{{ item.href }}" class="whitespace-nowrap" :class="active === '{{ id }}' ? 'text-ivory' : ''"><span class="prefix invisible" aria-hidden="true" :class="{ invisible: active !== '{{ id }}' }">&gt;</span>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>

      <p class="ml-auto shrink-0 text-label xl:ml-0">
        {%- if lang == "es" -%}
        <span class="text-ivory" aria-current="true">ES</span><span class="text-frost"> / </span><a href="{{ t.alternate.path }}" hreflang="{{ t.alternate.lang }}" class="text-haze">{{ t.alternate.label }}</a>
        {%- else -%}
        <a href="{{ t.alternate.path }}" hreflang="{{ t.alternate.lang }}" class="text-haze">{{ t.alternate.label }}</a><span class="text-frost"> / </span><span class="text-ivory" aria-current="true">EN</span>
        {%- endif -%}
      </p>

      <button type="button" @click="open = !open" aria-expanded="false" :aria-expanded="open ? 'true' : 'false'" aria-controls="nav-panel" class="shrink-0 text-label text-ivory hover:text-signal xl:hidden"><span class="prefix" aria-hidden="true">&gt;</span><span x-data="{ labels: { open: {{ t.close | dump }}, closed: {{ t.menu | dump }} } }" x-text="open ? labels.open : labels.closed">{{ t.menu }}</span></button>

    </div>
  </div>

  <nav id="nav-panel" aria-label="{{ t.navLabel }}" class="hidden bg-void xl:hidden" :class="{ hidden: !open }">
    <div class="mx-auto max-w-[1600px] px-6">
      <ul class="flex flex-col gap-y-4 pb-6 text-label text-haze">
        {%- for item in t.nav %}
        {%- set id = item.href | replace("#", "") %}
        <li><a href="{{ item.href }}" @click="open = false" :class="active === '{{ id }}' ? 'text-ivory' : ''"><span class="prefix invisible" aria-hidden="true" :class="{ invisible: active !== '{{ id }}' }">&gt;</span>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </nav>
</header>

<div class="relative z-10 mx-auto flex min-h-svh max-w-[1600px] flex-col px-6 md:px-10 lg:px-16">

  <main id="main" class="flex-1">

    <section aria-labelledby="hero-name" x-intersect:leave="pastHero = true" x-intersect:enter="pastHero = false; active = ''" class="flex min-h-[80svh] flex-col justify-center pt-10 pb-10 md:pt-16">
      <div class="grid items-start gap-y-12 lg:grid-cols-[minmax(0,1fr)_448px] lg:gap-x-14">
        <div>
          <h1 id="hero-name" aria-label="{{ t.hero.name }}" class="text-display text-ivory"
              x-data="{ full: {{ t.hero.name | dump }}, shown: {{ t.hero.name | dump }} }"
              x-init="if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { shown = full } else { shown = ''; let i = 0; let tm = setInterval(() => { i += 1; shown = full.slice(0, i); if (i >= full.length) clearInterval(tm) }, 58) }">
            <span x-text="shown">{{ t.hero.name }}</span><span class="caret"></span>
          </h1>
          <p class="read mt-8 max-w-[45ch] text-lede text-ivory">{{ t.hero.line }}</p>
          <p class="mt-6 text-label text-frost">{{ t.hero.location }}</p>
        </div>
        <button type="button" aria-label="{{ t.hero.plate.label }}" aria-pressed="false" :aria-pressed="photo ? 'true' : 'false'" class="plate-tilt block w-full max-w-[448px]"
                x-data="{
                  photo: false,
                  altDither: {{ t.hero.plate.altDither | dump }},
                  altPhoto: {{ t.hero.plate.altPhoto | dump }},
                  tilt(e) {
                    if (e.pointerType !== 'mouse' || !window.matchMedia('(pointer: fine)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
                    let r = $el.getBoundingClientRect()
                    $el.style.setProperty('--ry', Math.round(((e.clientX - r.left) / r.width * 2 - 1) * 2) * 3 + 'deg')
                    $el.style.setProperty('--rx', Math.round(((e.clientY - r.top) / r.height * 2 - 1) * -2) * 3 + 'deg')
                  },
                  reset() { $el.style.removeProperty('--rx'); $el.style.removeProperty('--ry') }
                }"
                x-init="new Image().src = '/img/profile.webp'"
                @pointermove="tilt($event)" @pointerleave="reset()" @click="photo = !photo">
          <img src="/img/profile-dither.png" :src="photo ? '/img/profile.webp' : '/img/profile-dither.png'" width="448" height="445" :width="photo ? 588 : 448" :height="photo ? 584 : 445" alt="{{ t.hero.plate.altDither }}" :alt="photo ? altPhoto : altDither" class="plate h-auto w-full" :class="{ plate: !photo }" fetchpriority="high">
        </button>
      </div>

    </section>

    <section id="about" aria-labelledby="about-label" x-intersect:enter.margin.-45%.0.-45%.0="active = 'about'" class="scroll-offset pt-24 pb-24 md:pt-32">
      <h2 id="about-label" class="text-section text-ivory">{{ t.about.label }}</h2>
      <div class="read mt-4">
        <p class="max-w-[50ch] text-title text-ivory">{{ t.about.heading }}</p>
        <div class="mt-8 max-w-[70ch] space-y-3 text-body text-mist">
          {%- for paragraph in t.about.paragraphs %}
          <p>{{ paragraph }}</p>
          {%- endfor %}
        </div>
      </div>
    </section>

    <section id="now" aria-labelledby="now-label" x-intersect:enter.margin.-45%.0.-45%.0="active = 'now'" class="scroll-offset pb-24">
      <h2 id="now-label" class="text-section text-ivory">{{ t.now.label }}</h2>
      <div class="read mt-4">
        <p class="max-w-[50ch] text-title text-ivory">{{ t.now.heading }}</p>
        <ul class="mt-8 max-w-[70ch] space-y-3 text-body text-mist">
          {%- for item in t.now.items %}
          <li class="grid grid-cols-[1.7em_minmax(0,1fr)]"><span class="prefix" aria-hidden="true">&gt;</span><span>{{ item }}</span></li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    <section id="work" aria-labelledby="work-label" x-intersect:enter.margin.-45%.0.-45%.0="active = 'work'" class="scroll-offset pb-24"
             x-data="{
               selected: {{ last }},
               count: {{ n }},
               tones: ['var(--color-ivory)', 'var(--color-mist)', 'var(--color-haze)', 'var(--color-frost)'],
               tracks: ['0', '0.02em', '0.04em', '0.06em'],
               step(i) { return Math.min(Math.abs(i - this.selected), 3) },
               depth(i) { return { '--tone': this.tones[this.step(i)], '--track': this.tracks[this.step(i)] } },
               reveal(el) { if (el) el.scrollIntoView({ inline: 'center', block: 'nearest', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }) },
               jump(d) { let i = Math.min(Math.max(this.selected + d, 0), this.count - 1); this.selected = i; this.reveal(this.$refs.rail.querySelectorAll('button')[i]) },
               move(d, e) { let i = Math.min(Math.max(this.selected + d, 0), this.count - 1); let b = e.currentTarget.querySelectorAll('button')[i]; this.selected = i; b.focus(); this.reveal(b) }
             }"
             x-init="$nextTick(() => { let b = $refs.rail.querySelectorAll('button')[selected]; $refs.rail.scrollLeft = b.offsetLeft - ($refs.rail.clientWidth - b.offsetWidth) / 2 })">
      <h2 id="work-label" class="text-section text-ivory">{{ t.work.label }}</h2>
      <div class="read mt-4">
        <p class="max-w-[50ch] text-title text-ivory">{{ t.work.heading }}</p>
        <p class="mt-4 max-w-[66ch] text-body text-haze">{{ t.work.intro }}</p>
      </div>

      <div class="rail-sticky -mx-6 mt-8 md:-mx-10 lg:-mx-16">
        <span class="rail-dots" aria-hidden="true"></span>
        <ol x-ref="rail" @keydown.left.prevent="move(-1, $event)" @keydown.right.prevent="move(1, $event)" class="no-scrollbar relative flex snap-x snap-mandatory overflow-x-auto px-6 md:px-10 lg:px-16">
          {%- for role in roles %}
          {%- set d = last - loop.index0 %}
          {%- set s = 3 if d > 3 else d %}
          <li class="w-[10.5rem] shrink-0 snap-center md:w-auto md:flex-1">
            <button type="button" @click="selected = {{ loop.index0 }}; reveal($event.currentTarget)" aria-pressed="{{ 'true' if loop.index0 == last else 'false' }}" :aria-pressed="selected === {{ loop.index0 }} ? 'true' : 'false'" style="--tone: {{ tones[s] }}; --track: {{ tracks[s] }}" :style="depth({{ loop.index0 }})" class="rail-item flex w-full flex-col items-center px-2 text-center hover:text-signal focus-visible:text-signal">
              <span class="block h-[22px] text-label">{{ role.dates | startYear }}</span>
              <span class="rail-tick mt-2{% if role.current %} text-signal{% endif %}"></span>
              <span class="mt-4 block text-body tracking-[inherit]">{{ role.title }}</span>
              <span class="block text-body tracking-[inherit]">{{ role.company }}</span>
            </button>
          </li>
          {%- endfor %}
        </ol>
      </div>

      <div class="mt-16 space-y-16" aria-live="polite">
        {%- for role in roles %}
        <div class="{{ '' if loop.index0 == last else 'hidden' }}" :class="{ hidden: selected !== {{ loop.index0 }} }">
          <p class="read text-title font-medium text-ivory">{{ role.title }} · {{ role.company }}</p>
          <p class="mt-2 text-label text-frost">{{ role.dates }} · {{ role.location }}</p>
          <p class="max-w-[50ch] text-label text-frost">{{ role.stack | join(" · ") }}</p>
          <dl class="mt-5 max-w-[62ch] space-y-6">
            <div>
              <dt class="text-label text-frost">{{ t.work.keys.challenge }}</dt>
              <dd class="read text-body text-haze">{{ role.challenge }}</dd>
            </div>
            <div>
              <dt class="text-label text-frost">{{ t.work.keys.did }}</dt>
              <dd class="read text-body text-haze">{{ role.did }}</dd>
            </div>
            <div>
              <dt class="text-label text-frost">{{ role.resultLabel or t.work.keys.result }}</dt>
              <dd class="read text-body text-haze">{{ role.result }}</dd>
            </div>
          </dl>
        </div>
        {%- endfor %}
      </div>

      <ul class="mt-12 flex gap-x-10 text-label text-haze">
        <li><button type="button" @click="jump(-1)" :disabled="selected === 0" class="hover:text-signal disabled:cursor-default disabled:text-frost disabled:hover:text-frost"><span class="prefix" aria-hidden="true">&lt;</span>{{ t.work.prev }}</button></li>
        <li><button type="button" @click="jump(1)" disabled :disabled="selected === count - 1" class="hover:text-signal disabled:cursor-default disabled:text-frost disabled:hover:text-frost">{{ t.work.next }}<span class="suffix" aria-hidden="true">&gt;</span></button></li>
      </ul>
    </section>

    <section id="decide" aria-labelledby="decide-label" x-intersect:enter.margin.-45%.0.-45%.0="active = 'decide'" class="scroll-offset pb-24">
      <h2 id="decide-label" class="text-section text-ivory">{{ t.decide.label }}</h2>
      <div class="read mt-4">
        <p class="max-w-[50ch] text-title text-ivory">{{ t.decide.heading }}</p>
        <ul class="mt-12 space-y-10">
          {%- for item in t.decide.items %}
          <li class="max-w-[66ch]">
            <p class="text-title font-medium text-ivory">{{ item.title }}</p>
            <p class="mt-2 text-body text-haze">{{ item.text }}</p>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    <section aria-labelledby="oss-label" class="pb-24">
      <h2 id="oss-label" class="text-section text-ivory">{{ t.oss.label }}</h2>
      <div class="read mt-4">
        <p class="max-w-[50ch] text-title text-ivory">{{ t.oss.heading }}</p>
        <ul class="mt-8 max-w-[70ch] space-y-6">
          {%- for item in t.oss.items %}
          <li>
            <p class="text-title font-medium text-ivory"><span class="prefix" aria-hidden="true">&gt;</span><a href="{{ item.href }}" rel="noopener" target="_blank">{{ item.name }}<span class="sr-only">{{ t.newTab }}</span></a></p>
            <p class="mt-1 max-w-[66ch] pl-[1.7em] text-body text-haze">{{ item.text }}</p>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    <section aria-labelledby="stack-label" class="pb-24">
      <h2 id="stack-label" class="text-section text-ivory">{{ t.stack.label }}</h2>
      <div class="mt-4">
        <p class="read max-w-[50ch] text-title text-ivory">{{ t.stack.heading }}</p>
        <ul class="mt-8 max-w-[68ch] space-y-3">
        {%- for row in t.stack.rows %}
        <li class="grid gap-x-8 sm:grid-cols-[7rem_minmax(0,1fr)]">
          <span class="text-label text-frost">{{ row.key }}</span>
          <span class="text-body text-mist">{{ row.value }}</span>
        </li>
        {%- endfor %}
      </ul>
      </div>
    </section>

    <section id="contact" aria-labelledby="contact-label" x-intersect:enter.margin.-45%.0.-45%.0="active = 'contact'" class="scroll-offset pb-24">
      <h2 id="contact-label" class="text-section text-ivory">{{ t.contact.label }}</h2>
      <div class="mt-4 max-w-[68ch]">
        <p class="read max-w-[50ch] text-title text-ivory">{{ t.contact.lead }}</p>
        <p class="mt-8 text-lede wrap-anywhere text-ivory"><span class="prefix" aria-hidden="true">&gt;</span><a href="mailto:{{ t.contact.address }}">{{ t.contact.address }}</a></p>
        <ul class="mt-10 flex flex-wrap gap-x-9 gap-y-2 text-label text-frost">
          {%- for link in t.contact.links %}
          {%- if not link.primary %}
          {%- set ext = "mailto:" not in link.href %}
          <li><span class="prefix" aria-hidden="true">&gt;</span><a href="{{ link.href }}" rel="me noopener"{% if ext %} target="_blank"{% endif %}>{{ link.label }}{% if ext %}<span class="sr-only">{{ t.newTab }}</span>{% endif %}</a></li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </div>
    </section>

  </main>


</div>

</div>
